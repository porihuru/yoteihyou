{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "予定表をEdgeで開く",
            "type": "node",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/dev-server.js",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Development server ready at (https?://\\S+)",
                "uriFormat": "%s",
                "action": "debugWithEdge"
            }
        }
    ]
}
